# 部署机只需要现成镜像，不需要 Dockerfile 和源码。

APP_IMAGE=rag-core-int:amd64
DOCKER_PLATFORM=linux/amd64
APP_PORT=8080
TZ=Asia/Shanghai
JAVA_OPTS=-Xms256m -Xmx512m

# Dify 元数据库连接
RAG_DATASOURCE_METADATA_DIFY_URL=jdbc:postgresql://host.docker.internal:5432/dify
RAG_DATASOURCE_METADATA_DIFY_USERNAME=postgres
RAG_DATASOURCE_METADATA_DIFY_PASSWORD=your-password

# Chat Memory 数据库连接（Spring Boot 标准数据源）
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/rag
SPRING_DATASOURCE_USERNAME=rag
SPRING_DATASOURCE_PASSWORD=your-password
SPRING_AI_CHAT_MEMORY_REPOSITORY_JDBC_INITIALIZE_SCHEMA=always

# 回答侧对话记忆配置
# RAG_CHAT_MEMORY_ENABLED: 全局开关；请求仍需传 memory.conversationId 才会使用历史。
RAG_CHAT_MEMORY_ENABLED=true
# RAG_CHAT_MEMORY_WINDOW_TURNS: 回答时优先保留最近多少轮 user/assistant 原文历史。
RAG_CHAT_MEMORY_WINDOW_TURNS=10
# RAG_CHAT_MAX_REQUEST_CONTEXT_TOKENS: 单次请求实际上下文预算上限；少卡部署建议 32768 或 65536。
RAG_CHAT_MAX_REQUEST_CONTEXT_TOKENS=32768
# RAG_CHAT_MEMORY_TOKEN_BUDGET_RATIO: 记忆最多占单次上下文预算的比例。
RAG_CHAT_MEMORY_TOKEN_BUDGET_RATIO=0.2
# RAG_CHAT_SUMMARY_ENABLED: 是否为更早历史生成摘要；摘要异步更新，不阻塞本轮回答。
RAG_CHAT_SUMMARY_ENABLED=true
# RAG_CHAT_SUMMARY_TRIGGER_TURNS: 更早未摘要历史累计多少轮后触发一次摘要。
RAG_CHAT_SUMMARY_TRIGGER_TURNS=10
# RAG_CHAT_SUMMARY_MAX_TOKENS: 单次摘要最大 token 数。
RAG_CHAT_SUMMARY_MAX_TOKENS=512

# RAG Trace 异步持久化配置
# Trace 写入 Spring 主业务库，也就是 SPRING_AI_CHAT_MEMORY 所在库；不要配置到 Dify 库。
RAG_TRACE_ENABLED=true
RAG_TRACE_MODE=summary
RAG_TRACE_INCLUDE_SENSITIVE_PAYLOAD=false
RAG_TRACE_TEXT_PREVIEW_LENGTH=120
RAG_TRACE_MAX_PAYLOAD_BYTES=32768
RAG_TRACE_MAX_CANDIDATES_PER_EVENT=10
RAG_TRACE_SAMPLE_RATE=1.0
RAG_TRACE_JDBC_ENABLED=true
RAG_TRACE_QUEUE_CAPACITY=10000
RAG_TRACE_BATCH_SIZE=100
RAG_TRACE_FLUSH_INTERVAL_MS=1000
RAG_TRACE_SHUTDOWN_TIMEOUT_MS=5000
RAG_TRACE_OVERFLOW_POLICY=drop_oldest
RAG_TRACE_OFFER_TIMEOUT_MS=0
RAG_TRACE_FILE_ENABLED=false
RAG_TRACE_FILE_OUTPUT_DIR=/app/logs/traces

# Milvus 连接
MILVUS_URI=http://host.docker.internal:19530
MILVUS_USERNAME=root
MILVUS_PASSWORD=Milvus

# 元数据缓存配置
METADATA_CACHER_CACHE_TYPE=in-memory
# 部署自检时建议先关闭预热和定时同步，避免外部 Dify 数据库未就绪时影响服务启动观察。
METADATA_CACHER_WARMUP_ENABLED=false
METADATA_CACHER_SCHEDULER_DIFY_DB_ENABLED=false
METADATA_CACHER_DIFY_DEFAULT_TENANT_ID=default
METADATA_CACHER_DIFY_DEFAULT_API_KEY=your-plain-api-key
METADATA_CACHER_SCHEDULER_DIFY_DB_INITIAL_DELAY_MS=5000
METADATA_CACHER_SCHEDULER_DIFY_DB_FIXED_DELAY_MS=30000

# 查询规划默认配置
QUERY_PLANNER_DEFAULT_PLAN_TYPE=standard_retrieval
QUERY_PLANNER_DEFAULTS_EMBEDDING_MODEL_ID=bge-m3-embedding
QUERY_PLANNER_DEFAULTS_RERANK_MODEL_ID=bge-reranker-v2
QUERY_PLANNER_DEFAULTS_TOP_K=5
QUERY_PLANNER_DEFAULTS_CANDIDATE_K=20

# 问答默认模型，推荐直接使用模型名称
APP_RAG_ANSWER_DEFAULT_LLM_MODEL=your-llm-model-name
